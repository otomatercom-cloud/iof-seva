# Server-side only. Never commit real values.
NEXT_PUBLIC_DATA_SOURCE=odoo            # odoo | mock (demo data, no Odoo)
ODOO_URL=https://your-odoo-domain.example
ODOO_BASE_URL=https://your-odoo-domain.example   # same value (public-site code)
ODOO_DB=your_db
ODOO_DATABASE=your_db                   # same value (needed for the visual editor login)
# Settings -> Technical -> System Parameters -> iof_volunteer_registration.api_token
ODOO_API_TOKEN=replace-with-token-from-odoo
SITE_URL=https://your-site-domain.example
ODOO_PUBLIC_URL=                        # only if media is served from another URL than ODOO_URL
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000
CONTENT_REVALIDATE_S=30
