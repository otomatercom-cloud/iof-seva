<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_iof_site_layout_list" model="ir.ui.view">
        <field name="name">iof.site.layout.list</field>
        <field name="model">iof.site.layout</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="page"/>
                <field name="write_date"/>
            </list>
        </field>
    </record>
    <record id="view_iof_site_layout_form" model="ir.ui.view">
        <field name="name">iof.site.layout.form</field>
        <field name="model">iof.site.layout</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header><button name="action_reset" type="object" string="Reset page to default layout"
                                confirm="Remove the saved section order / hidden sections for this page?"/></header>
                <sheet><group><field name="page"/><field name="data"/></group></sheet>
            </form>
        </field>
    </record>
    <record id="action_iof_site_layout" model="ir.actions.act_window">
        <field name="name">Page Layouts</field>
        <field name="res_model">iof.site.layout</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
