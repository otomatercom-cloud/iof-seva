<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_iof_registration_list_approved" model="ir.ui.view">
        <field name="name">iof.volunteer.registration.list.approved</field>
        <field name="model">iof.volunteer.registration</field>
        <field name="arch" type="xml">
            <list>
                <field name="photo" widget="image" options="{'size': [32, 40]}"/>
                <field name="name"/>
                <field name="full_name"/>
                <field name="member_number" string="Member ID"/>
                <field name="card_status" widget="badge" decoration-success="card_status == 'active'"
                       decoration-warning="card_status in ('suspended', 'expired')"
                       decoration-danger="card_status == 'cancelled'"/>
                <field name="mobile"/>
                <field name="email"/>
                <field name="saudi_city"/>
                <field name="registration_date"/>
            </list>
        </field>
    </record>

    <record id="action_iof_approved_volunteers" model="ir.actions.act_window">
        <field name="name">Approved Volunteers</field>
        <field name="res_model">iof.volunteer.registration</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'approved')]</field>
        <field name="search_view_id" ref="iof_volunteer_registration.view_iof_registration_search"/>
        <field name="context">{}</field>
    </record>
    <record id="action_iof_approved_volunteers_list" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="action_iof_approved_volunteers"/>
        <field name="view_mode">list</field>
        <field name="sequence">1</field>
        <field name="view_id" ref="view_iof_registration_list_approved"/>
    </record>
    <record id="action_iof_approved_volunteers_form" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="action_iof_approved_volunteers"/>
        <field name="view_mode">form</field>
        <field name="sequence">2</field>
    </record>

    <menuitem id="menu_iof_approved_volunteers" name="Approved Volunteers"
              parent="iof_volunteer_registration.menu_iof_root"
              action="action_iof_approved_volunteers" sequence="20"/>
</odoo>
