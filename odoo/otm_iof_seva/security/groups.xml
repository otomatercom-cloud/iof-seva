<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_iof_seva" model="res.groups.privilege">
        <field name="name">IOF Seva</field>
        <field name="category_id" ref="base.module_category_customizations"/>
    </record>

    <record id="group_iof_handler" model="res.groups">
        <field name="name">Case Handler</field>
        <field name="privilege_id" ref="privilege_iof_seva"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_iof_coordinator" model="res.groups">
        <field name="name">Coordinator</field>
        <field name="privilege_id" ref="privilege_iof_seva"/>
        <field name="implied_ids" eval="[(4, ref('group_iof_handler'))]"/>
    </record>
    <record id="group_iof_head" model="res.groups">
        <field name="name">Province Head (Seva Coordinator)</field>
        <field name="privilege_id" ref="privilege_iof_seva"/>
        <field name="implied_ids" eval="[(4, ref('group_iof_coordinator'))]"/>
    </record>
    <record id="group_iof_secretary" model="res.groups">
        <field name="name">Secretary</field>
        <field name="privilege_id" ref="privilege_iof_seva"/>
        <field name="implied_ids" eval="[(4, ref('group_iof_head'))]"/>
    </record>
    <record id="group_iof_president" model="res.groups">
        <field name="name">President</field>
        <field name="privilege_id" ref="privilege_iof_seva"/>
        <field name="implied_ids" eval="[(4, ref('group_iof_secretary'))]"/>
    </record>
</odoo>
