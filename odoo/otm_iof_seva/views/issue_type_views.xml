<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_iof_issue_type_list" model="ir.ui.view">
        <field name="name">otm.iof.issue.type.list</field>
        <field name="model">otm.iof.issue.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category"/>
                <field name="default_priority"/>
            </list>
        </field>
    </record>
    <record id="view_iof_issue_type_form" model="ir.ui.view">
        <field name="name">otm.iof.issue.type.form</field>
        <field name="model">otm.iof.issue.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="category"/>
                            <field name="default_priority"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_iof_issue_type" model="ir.actions.act_window">
        <field name="name">Issue Types</field>
        <field name="res_model">otm.iof.issue.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
