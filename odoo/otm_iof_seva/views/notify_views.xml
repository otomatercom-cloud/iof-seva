<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_iof_notify_event_list" model="ir.ui.view">
        <field name="name">otm.iof.notify.event.list</field>
        <field name="model">otm.iof.notify.event</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="0">
                <field name="sequence" widget="handle"/>
                <field name="code" readonly="1"/>
                <field name="email"/>
                <field name="whatsapp"/>
            </list>
        </field>
    </record>
    <record id="action_iof_notify_event" model="ir.actions.act_window">
        <field name="name">Notifications</field>
        <field name="res_model">otm.iof.notify.event</field>
        <field name="view_mode">list</field>
    </record>
    <record id="view_iof_outbox_list" model="ir.ui.view">
        <field name="name">otm.iof.outbox.list</field>
        <field name="model">otm.iof.outbox</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-danger="state == 'failed'">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="number"/>
                <field name="event"/>
                <field name="state"/>
                <field name="tries"/>
                <field name="error"/>
            </list>
        </field>
    </record>
    <record id="action_iof_outbox" model="ir.actions.act_window">
        <field name="name">WhatsApp Outbox</field>
        <field name="res_model">otm.iof.outbox</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
