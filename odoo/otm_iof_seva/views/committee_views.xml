<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_iof_committee_list" model="ir.ui.view">
        <field name="name">otm.iof.committee.list</field>
        <field name="model">otm.iof.committee</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="region"/>
                <field name="kind"/>
                <field name="case_prefix"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>
    <record id="view_iof_committee_form" model="ir.ui.view">
        <field name="name">otm.iof.committee.form</field>
        <field name="model">otm.iof.committee</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="region"/>
                            <field name="kind"/>
                        </group>
                        <group>
                            <field name="parent_id"/>
                            <field name="case_prefix"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_iof_committee" model="ir.actions.act_window">
        <field name="name">Committees</field>
        <field name="res_model">otm.iof.committee</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
