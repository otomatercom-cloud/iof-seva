<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_iof_volunteer" model="res.groups.privilege">
        <field name="name">IOF Volunteer Registration</field>
        <field name="category_id" ref="base.module_category_customizations"/>
    </record>

    <record id="group_iof_volunteer_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_iof_volunteer"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_iof_volunteer_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_iof_volunteer"/>
        <field name="implied_ids" eval="[(4, ref('group_iof_volunteer_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
